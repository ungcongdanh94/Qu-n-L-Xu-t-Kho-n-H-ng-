# Doi ten file nay thanh .env va chinh sua truoc khi chay
PORT=3000
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-kho-doan

# Thong bao day (Web Push) - chay lenh "npm run generate-vapid" de tao 2 gia tri ben duoi
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ten-anh@vidu.com

# Nhan dien OCR: mac dinh dung ban "best" (chinh xac cao nhat, hoi cham hon).
# Neu thay xu ly qua cham, dat gia tri = 0 de quay lai ban tieu chuan (nhanh hon).
OCR_USE_BEST=1
